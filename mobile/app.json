{
  "expo": {
    "name": "دين ودنيا",
    "slug": "deen-w-donya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "deenwdounya",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.deenwdonya.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D7C66",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.deenwdonya.app",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0D7C66"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b225418-70f0-4320-ab5d-ec1f409d2e0a"
      }
    }
  }
}
